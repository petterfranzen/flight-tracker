# /etc/systemd/system/flight-tracker.service
# Single JVM: REST + WebSocket + static SPA + pollers + SQLite.
# Listens on 127.0.0.1:8080 only; cloudflared is the sole way in.
[Unit]
Description=Flight tracker
After=network-online.target
Wants=network-online.target
# Stays inactive until the first deploy has installed a jar.
ConditionPathExists=/opt/flight-tracker/app/current.jar

[Service]
Type=simple
User=flighttracker
Group=flighttracker
StateDirectory=flight-tracker
StateDirectoryMode=0750
WorkingDirectory=/var/lib/flight-tracker
EnvironmentFile=/etc/flight-tracker/env
Environment=FLIGHTTRACKER_DB_PATH=/var/lib/flight-tracker/flighttracker.db
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_PORT=8080
Environment=TRUST_LOCAL=false
# Heap sized to the measured live set (~200 MB) plus headroom; Serial GC
# because this is a mostly idle single-user app (G1's own structures were
# ~60 MB). See docs/perf/PROFILE-2026-10.md.
ExecStart=/usr/bin/java -Xms128m -Xmx384m -XX:+UseSerialGC -XX:ReservedCodeCacheSize=64m -Xss512k \
    -XX:+ExitOnOutOfMemoryError \
    -jar /opt/flight-tracker/app/current.jar
SuccessExitStatus=143
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Memory: these limits also count the kernel page cache of the database
# file. The JVM's anonymous memory (heap, metaspace, code, and SQLite's own
# per-connection page caches on the native heap) must stay well below
# MemoryHigh, or the cache the database needs is reclaimed and every query
# reads from disk (measured: ~600 MB anon with the flags above, vs ~1.2 GB
# and still growing with the old -Xmx768m G1 setup).
MemoryHigh=1400M
MemoryMax=1800M

# Hardening. No MemoryDenyWriteExecute: the JIT needs W+X pages.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
