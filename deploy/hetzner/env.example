# /etc/flight-tracker/env  (owner root:flighttracker, mode 0640)
# OpenSky OAuth2 client-credentials app (opensky-network.org → Account → API client).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Swedavia FlightInfo v2 (arrival confirmation, optional; free tier).
# Get a key: apideveloper.swedavia.se -> sign up -> subscribe to the FlightInfo product.
# Without a key the provider stays off. Keys rotate every 6 months: put the other one
# in the SECONDARY variable so a rotation does not interrupt it.
# SWEDAVIA_API_KEY=
# SWEDAVIA_API_KEY_SECONDARY=

# AeroDataBox (arrival confirmation, optional; free Basic plan). The fallback for airports
# Swedavia does not cover. Get a key: rapid.aerodatabox.com -> sign up on RapidAPI ->
# subscribe to the Basic plan (400 units/month, a lookup costs 2) -> copy the X-RapidAPI-Key.
# Without a key the provider stays off. The free plan is non-commercial and requires
# attribution (the UI shows the credit link); commercial use needs a paid plan.
# AERODATABOX_API_KEY=

# Optional social login (design: section9-hq #84, step 3a). Register one OAuth app
# per provider, then paste its client id and secret here. A provider with no values
# stays off: its registration is never built and no sign-in option appears — nothing
# breaks. The callback URL to register is
#   <the host the app is served on>/login/oauth2/code/{google,github}
# (register it after the domain move of #58; design §4 says the registration step is
# the last one before flipping the flag).
#   Google: Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
#           -> Web application.
#   GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
