# Copy to .env alongside docker-compose.yml on the NAS and fill in.

# OpenSky OAuth2 client-credentials app (https://opensky-network.org/login).
# Optional — leave blank to skip the OpenSky origin/destination fallback;
# adsbdb's callsign route lookup covers scheduled-airline flights without it.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional overrides — uncomment to change from the defaults.
# DB_PASSWORD=flighttracker
# IMAGE_TAG=latest
# FRONTEND_PORT=8090
