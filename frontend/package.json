{
  "name": "flight-tracker-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test --grep-invert \"@perf|@scenario\"",
    "test:perf": "playwright test --grep @perf --workers=1",
    "test:scenarios": "playwright test --grep @scenario --workers=1"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "maplibre-gl": "^6.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  }
}
